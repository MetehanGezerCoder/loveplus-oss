# Love+ remote deployment template. Copy to `.env.production`, replace every value, and keep
# the real file out of version control and off Slack. Nothing here belongs in the APK.
#
#   cp .env.production.example .env.production
#   docker compose --env-file .env.production -f docker-compose.prod.yml config
#
# Generate the JWT signing key and the database/cache passwords locally, for example:
#   openssl rand -base64 64   # JWT_SIGNING_KEY (must be at least 64 UTF-8 bytes)
#   openssl rand -base64 24   # POSTGRES_PASSWORD / REDIS_PASSWORD

# --- Public endpoint -------------------------------------------------------------------
# The domain both phones will reach. Its DNS A/AAAA record must already point at this host,
# otherwise Caddy cannot obtain a certificate.
LOVEPLUS_DOMAIN=loveplus.example.com
LOVEPLUS_ACME_EMAIL=you@example.com

# --- Data stores -----------------------------------------------------------------------
POSTGRES_DB=loveplus
POSTGRES_USER=loveplus
POSTGRES_PASSWORD=
REDIS_PASSWORD=

# --- Tokens ----------------------------------------------------------------------------
JWT_ISSUER=loveplus-api
JWT_AUDIENCE=loveplus-mobile
JWT_SIGNING_KEY=
JWT_ACCESS_TOKEN_MINUTES=15
JWT_TELEMETRY_TOKEN_DAYS=7
JWT_REFRESH_TOKEN_DAYS=30

# --- Proxy trust -----------------------------------------------------------------------
# Only the reverse proxy may set X-Forwarded-For/Proto. Docker's default bridge pool is
# 172.16.0.0/12; narrow this to the compose network subnet if you pin one.
API_TRUSTED_PROXIES=172.16.0.0/12

# --- Presence --------------------------------------------------------------------------
# The Android foreground service posts telemetry on this cadence. The online window must stay
# at least twice the cadence so one missed beat does not report a connected partner offline;
# startup refuses a narrower window.
REALTIME_CLIENT_HEARTBEAT_SECONDS=60
REALTIME_ONLINE_SECONDS=180
REALTIME_RECENTLY_ONLINE_SECONDS=600

# --- Push ------------------------------------------------------------------------------
# `firebase` requires PUSH_FIREBASE_SERVICE_ACCOUNT_JSON. `disabled` is a deliberate
# statement that this deployment runs without notifications; the API will not start on any
# other value.
PUSH_PROVIDER=disabled
# Minified single-line service-account JSON from the Firebase console
# (Project settings > Service accounts > Generate new private key).
PUSH_FIREBASE_SERVICE_ACCOUNT_JSON=
