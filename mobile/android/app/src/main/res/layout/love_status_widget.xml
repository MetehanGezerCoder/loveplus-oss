<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:padding="16dp" android:background="@drawable/widget_background">
    <TextView android:id="@+id/widget_brand" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Love+" android:textColor="#ff6fae" android:textStyle="bold" android:textSize="15sp" />
    <TextView android:id="@+id/widget_partner_name" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:text="Partner" android:textColor="#ffffff" android:textStyle="bold" android:textSize="22sp" />
    <TextView android:id="@+id/widget_summary" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="Pil —  •  Mesafe —" android:textColor="#ffffff" android:textSize="15sp" />
    <TextView android:id="@+id/widget_activity" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:text="Aktivite —" android:textColor="#cdbfce" android:textSize="13sp" />
    <TextView android:id="@+id/widget_freshness" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:text="Henüz güncelleme yok" android:textColor="#cdbfce" android:textSize="12sp" />
</LinearLayout>
