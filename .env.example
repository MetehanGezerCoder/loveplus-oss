POSTGRES_DB=loveplus
POSTGRES_USER=loveplus
POSTGRES_PASSWORD=replace-with-a-local-development-password
REDIS_PASSWORD=replace-with-a-local-development-password
MINIO_ROOT_USER=loveplus
MINIO_ROOT_PASSWORD=replace-with-a-local-development-password
ConnectionStrings__Postgres="Host=localhost;Port=5432;Database=loveplus;Username=loveplus;Password=replace-with-a-local-development-password"
ConnectionStrings__Redis="localhost:6379,password=replace-with-a-local-development-password,abortConnect=false"
Jwt__Issuer=loveplus-api
Jwt__Audience=loveplus-mobile
Jwt__SigningKey=replace-with-at-least-64-random-characters-before-running-the-api
Jwt__AccessTokenMinutes=15
Jwt__TelemetryTokenDays=7
Jwt__RefreshTokenDays=30
ASPNETCORE_URLS=http://localhost:5080
ASPNETCORE_ENVIRONMENT=Development
LOVEPLUS_API_BASE_URL=http://10.0.2.2:5080
LOVEPLUS_GOOGLE_MAPS_API_KEY=
Demo__SeedEnabled=false
Demo__Password=replace-with-the-private-demo-password
Demo__UseInMemoryInfrastructure=false
Database__MigrateOnStartup=true
Realtime__ClientStatusHeartbeatSeconds=60
Realtime__OnlineSeconds=180
Realtime__RecentlyOnlineSeconds=600
Push__Provider=
Push__Firebase__ServiceAccountJson=
